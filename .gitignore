# =============================================================================
# Python cache / packaging
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
docs/_build/
build/
dist/
*.egg-info/
pip-wheel-metadata/

# =============================================================================
# Virtual environments
# =============================================================================
.venv/
venv/
env/
ENV/

# =============================================================================
# Test caches / temporary files
# =============================================================================
.cache/
.ipynb_checkpoints/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# =============================================================================
# Logs / experiment outputs / reports
# Keep source fixtures and small JSON/JSONL files trackable; ignore output dirs.
# =============================================================================
*.log
*.out
logs/
runs/
wandb/
outputs/
output/
results/
bench_results/
reports/
excel_reports/
test_results/
test_runs/
tests/*_results/
nohup_output*/
outdate/
batch_results/
deduplicated_results/
meeting_data/
meeting_frontend_data/
hippo_save_data/
**/conversation_semantic_storage/

# =============================================================================
# External datasets / generated benchmark data
# Keep local downloads and generated graphs out of the public tree while
# allowing dataset README files to document the expected download locations.
# =============================================================================
data/
datasets/
dataset/
*/datasets/
*/dataset/*
!*/dataset/
!*/dataset/README.md

benchmark_locomo/dataset/*
!benchmark_locomo/dataset/
!benchmark_locomo/dataset/README.md

benchmark_longmemeval/dataset/*
!benchmark_longmemeval/dataset/
!benchmark_longmemeval/dataset/README.md

benchmark_self_host/locomo10/dataset/*
!benchmark_self_host/locomo10/dataset/
!benchmark_self_host/locomo10/dataset/README.md

benchmark_self_host/longmemeval/dataset/*
!benchmark_self_host/longmemeval/dataset/
!benchmark_self_host/longmemeval/dataset/README.md

# Self-host reproduction artifacts generated by build/retrieve/generate/score.
benchmark_self_host/*/memory/
benchmark_self_host/*/retrieve/
benchmark_self_host/*/generate/
benchmark_self_host/*/score/
benchmark_self_host/*/logs/
benchmark_self_host/*/runs/
benchmark_self_host/*/test_runs/

# Private task-eval analysis code is not part of the public artifact.
benchmark_locomo/task_eval/private/
benchmark_longmemeval/task_eval/private/

# Allow small fixtures and examples when they are intentionally committed.
!tests/fixtures/
!tests/fixtures/**

# =============================================================================
# Model weights / checkpoints
# =============================================================================
*.pt
*.pth
*.ckpt
*.h5
*.bin
*.safetensors
*.gguf
*.faissindex
*.pkl
models/
checkpoints/

# =============================================================================
# Local secrets / machine-specific config
# =============================================================================
.env
.env.*
!.env.example
!**/.env.example
!.env.template
!**/.env.template
!env.template
!**/env.template
benchmark/scripts/env.sh
benchmark_*/scripts/env.sh
**/scripts/env.sh
scripts/env.sh

# =============================================================================
# IDE / OS
# =============================================================================
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
.VSCodeCounter/

# =============================================================================
# Old Git backup / local repository copies
# =============================================================================
.git_old_group_repo_backup/
backup.sh
