# AgentMemorySystem environment template
# Copy this file to .env and fill in only the providers you actually use.

# ===== LLM provider API keys =====
DEEPSEEK_API_KEY=
CLOSEAI_API_KEY=
CSTCLOUD_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# ===== Embedding / rerank provider API keys =====
SILICONFLOW_API_KEY=

# ===== Hugging Face =====
HF_TOKEN=
HUGGINGFACE_TOKEN=
HF_ENDPOINT=https://huggingface.co
HF_HOME=

# ===== OpenAI-compatible provider base URLs =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
CSTCLOUD_BASE_URL=https://uni-api.cstcloud.cn/v1
OPENAI_BASE_URL=https://api.openai.com/v1
CLOSEAI_BASE_URL=https://api.openai-proxy.org/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding / rerank endpoints =====
SILICONFLOW_EMBEDDINGS_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_RERANK_URL=https://api.siliconflow.cn/v1/rerank
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
CSTCLOUD_RERANK_URL=https://uni-api.cstcloud.cn/v1/rerank

# ===== Local reranker backend =====
# native: PyTorch/Transformers CUDA optimized path. vllm: external vLLM HTTP service.
RERANKER_BACKEND=native
VLLM_GPU_MEMORY_UTILIZATION=0.5
VLLM_API_URL=http://localhost:8000/score
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=30
VLLM_MAX_RETRIES=2

# # ===== Auto Builder / high-level memory pipeline =====
# # Spaces used by MemoryOrchestrator.
# AUTO_BUILDER_RAW_SPACE_NAME=raw
# AUTO_BUILDER_L0_SPACE_NAME=L0_Observation

# # L0 preprocessing. locomo10 uses Contextual Retrieval; longmemeval/default use chunking.
# AUTO_BUILDER_ENABLE_CONTEXTUAL_RETRIEVAL=true
# AUTO_BUILDER_CONTEXTUAL_PARALLEL_WORKERS=5
# AUTO_BUILDER_CHUNK_SIZE=512
# AUTO_BUILDER_CHUNK_OVERLAP=50

# # Tower switches. Strategy build_l1/build_l2 below still decides hierarchical L1/L2 per style.
# AUTO_BUILDER_ENABLE_HIERARCHICAL=true
# AUTO_BUILDER_ENABLE_EPISODIC=true
# AUTO_BUILDER_ENABLE_ENTITY_RELATION=true
# AUTO_BUILDER_ADD_TO_SYSTEM=true

# # Deduplication / relation behavior.
# AUTO_BUILDER_ENABLE_HIERARCHICAL_DEDUPLICATION=false
# AUTO_BUILDER_ENABLE_EPISODIC_DEDUPLICATION=true
# AUTO_BUILDER_EPISODIC_DEDUP_METHOD=dbscan_llm
# AUTO_BUILDER_ENABLE_RELATION_EXTRACTION=true
# AUTO_BUILDER_ENABLE_ENTITY_DEDUPLICATION=true

# # ===== Auto Builder strategy presets =====
# # l0_mode values: cr, chunk
# # locomo10 aligns with LoCoMo offline Step1 CR + Step2 L1 + Step3 L2.
# AUTO_BUILDER_LOCOMO10_L0_MODE=cr
# AUTO_BUILDER_LOCOMO10_BUILD_L1=true
# AUTO_BUILDER_LOCOMO10_BUILD_L2=true
# AUTO_BUILDER_LOCOMO10_EXTRACTION_LLM=qwen-3.5-plus-thinking
# AUTO_BUILDER_LOCOMO10_DEDUP_LLM=deepseek-v3.2-dashscope

# # longmemeval aligns with offline physical chunking and disables online hierarchical L1/L2.
# AUTO_BUILDER_LONGMEMEVAL_L0_MODE=chunk
# AUTO_BUILDER_LONGMEMEVAL_BUILD_L1=false
# AUTO_BUILDER_LONGMEMEVAL_BUILD_L2=false
# AUTO_BUILDER_LONGMEMEVAL_EXTRACTION_LLM=qwen-3.5-plus-thinking
# AUTO_BUILDER_LONGMEMEVAL_DEDUP_LLM=deepseek-v3.2-dashscope

# # default keeps a general-purpose chunking pipeline with online hierarchical L1/L2 enabled.
# AUTO_BUILDER_DEFAULT_L0_MODE=chunk
# AUTO_BUILDER_DEFAULT_BUILD_L1=true
# AUTO_BUILDER_DEFAULT_BUILD_L2=true
# AUTO_BUILDER_DEFAULT_EXTRACTION_LLM=qwen-3.5-plus-thinking
# AUTO_BUILDER_DEFAULT_DEDUP_LLM=deepseek-v3.2-dashscope