# Mandol environment template
# Copy this file to .env and fill in only the providers you actually use.

# ===== LLM provider API keys =====
DEEPSEEK_API_KEY=
CLOSEAI_API_KEY=
CSTCLOUD_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# ===== Embedding / rerank provider API keys =====
SILICONFLOW_API_KEY=

# ===== Hugging Face =====
HF_TOKEN=
HUGGINGFACE_TOKEN=
HF_ENDPOINT=https://huggingface.co
HF_HOME=

# ===== OpenAI-compatible provider base URLs =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
CSTCLOUD_BASE_URL=https://uni-api.cstcloud.cn/v1
OPENAI_BASE_URL=https://api.openai.com/v1
CLOSEAI_BASE_URL=https://api.openai-proxy.org/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Embedding / rerank endpoints =====
SILICONFLOW_EMBEDDINGS_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_RERANK_URL=https://api.siliconflow.cn/v1/rerank
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
CSTCLOUD_RERANK_URL=https://uni-api.cstcloud.cn/v1/rerank

# ===== Local reranker backend =====
# native: PyTorch/Transformers CUDA optimized path. vllm: external vLLM HTTP service.
RERANKER_BACKEND=native
VLLM_GPU_MEMORY_UTILIZATION=0.5
VLLM_API_URL=http://localhost:8000/score
VLLM_API_KEY=
VLLM_TIMEOUT_SECONDS=30
VLLM_MAX_RETRIES=2

# ===== Optional runtime tuning =====
# Maximum spaCy worker processes used by BM25 tokenization. Unset means auto.
# MANDOL_BM25_SPACY_MAX_PROCESSES=4

# Root directory containing locally fine-tuned quantification models.
# MANDOLIN_MODEL_DIR=/absolute/path/to/finetune_model

# Disable automatic root logging setup when embedding Mandol in another app.
# SKIP_AUTO_LOGGING=true
