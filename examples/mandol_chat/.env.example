# Mandol chat demo settings
MANDOL_CHAT_HOST=127.0.0.1
MANDOL_CHAT_PORT=8008
MANDOL_CHAT_DEBUG=false

# Default true: no external API key required.
MANDOL_CHAT_MOCK_LLM=true

# Default false: avoids loading heavy embedding models. Set true for real Mandol vector search.
MANDOL_CHAT_REAL_EMBEDDING=false

# Real LLM mode uses mandol.llm.llm_client.LLMClient when available.
MANDOL_CHAT_LLM_MODEL=gpt-4o-mini-closeai
OPENAI_API_KEY=

MANDOL_CHAT_DATA_DIR=examples/mandol_chat/mandol_chat/data
